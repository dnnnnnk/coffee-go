# .env

# --- runtime ---
ENV=dev
TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO

# --- telegram ---
BOT_TOKEN=8422275637:AAH6sZ7skomAYv0Lo3NzK_u629mT8arKAkg
# ADMINS=123456789,987654321

# --- db ---
DB_PATH=./data/easycoffee.sqlite3
DB_WAL=1
DB_FOREIGN_KEYS=1
DB_TIMEOUT_SEC=30
DB_ECHO_SQL=0
DB_POOL_SIZE=5

# --- cart/ui limits ---
MENU_PAGE_SIZE=8
MAX_CART_ITEMS=30
MAX_QTY_PER_ITEM=20
ORDER_CODE_LENGTH=6
ORDER_CODE_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# --- overload ---
OVERLOAD_AUTO_ENABLED=0
OVERLOAD_ACTIVE_ORDERS_LIMIT=25
OVERLOAD_ACTIVE_STATUSES=paid,accepted,in_progress

# --- payments ---
PAYMENTS_ENABLED=0
CURRENCY=RUB
PAYMENT_CAPTURE=1
PAYMENT_DESCRIPTION_PREFIX=EasyCoffee order
PAYMENT_RETURN_URL=https://example.com/paid

# YooKassa (только если PAYMENTS_ENABLED=1)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# optional timeout for YooKassa client
YOOKASSA_TIMEOUT_SEC=15

# --- webhooks / api ---
WEBHOOKS_ENABLED=0
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
WEBHOOK_SECRET=dev_secret_change_me
YOOKASSA_WEBHOOK_PATH=/webhooks/yookassa
API_PREFIX=/api

# Если хочешь, чтобы бот сам передавал notification_url в create_payment:
# (должен быть публичный HTTPS домен)
# PUBLIC_BASE_URL=https://your-domain.com
